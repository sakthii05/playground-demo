# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# album assets: only the file types the Top Hits page uses are kept and deployed, so a stray file
# (a saved web page, an editor backup, the full-length song) never reaches the live site
/public/spotify-hits/**/*
!/public/spotify-hits/**/
!/public/spotify-hits/**/*.webp
!/public/spotify-hits/**/*.mp3
!/public/spotify-hits/**/*.lrc
!/public/spotify-hits/**/.gitkeep

# Top Hits: the original art optimize:hits was made from (kept locally, never deployed)
/art-src/
